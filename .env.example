# =============================================================================
# ENVIRONMENT VARIABLES TEMPLATE
# Copy this file to .env.local and fill in your values.
# .env.local is git-ignored and should NEVER be committed.
# =============================================================================

# --- API ---
# Base URL for your backend API (required)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# --- App ---
# Public URL of this frontend (optional, used in metadata)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Build (CI/Docker) ---
# Set to "true" in Docker builds or CI pipelines where production secrets
# are not available at build time. This skips @t3-oss/env-nextjs validation.
# SKIP_ENV_VALIDATION=true
